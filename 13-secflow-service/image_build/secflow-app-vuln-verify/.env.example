# SecFlow skills lifecycle environment template.
# Copy this file to ~/.config/secocto/.env locally, or mount a Kubernetes Secret
# to /root/.config/secocto/.env inside the container.
# Do not commit real tokens or credentials.

SECOCTO_AGENT_TYPE=pi
SECOCTO_APP_NAME=secflow-app-vuln-verify

# SecOcto reverse proxy endpoints. All backend services are routed through
# 172.31.23.37:18888 with service-specific /api/secocto/v1/* prefixes.
GITEA_URL=http://172.31.23.37:18888/api/secocto/v1/gitea
SKILL_RECALL_URL=http://172.31.23.37:18888/api/secocto/v1/skills
TASK_RESTORE_URL=http://172.31.23.37:18888/api/secocto/v1/tasks
VULN_RESTORE_URL=http://172.31.23.37:18888/api/secocto/v1/vulns
WIKI_WEBDAV_URL=http://172.31.23.37:18888/api/secocto/v1/wiki
MEM_RECALL_URL=http://172.31.23.37:18888/api/secocto/v1/memories

# MinIO / task-trace object storage endpoint.
TASK_TRACE_UPLOAD_ENABLED=1
TASK_TRACE_HTTP_ENDPOINT=http://172.31.23.37:18888/api/secocto/v1/minio
TASK_TRACE_PUBLIC_BASE_URL=http://172.31.23.37:18888/api/secocto/v1/minio
TASK_TRACE_BUCKET=task-traces
TASK_TRACE_PREFIX=traces

# Optional credentials. Fill these via Secret, not in git.
GITEA_TOKEN=
MEM_RECALL_API_TOKEN=

# Optional lifecycle switch.
SECOCTO_HOOKS_ENABLED=1
POST_TASK_SKILLS=post-task-reflect,distill-experience,task-score,task-trace,vuln-report,sec-skill-local-evolve,skill-recall-onboard,skill-recall-propose,task-collect
